import { useState, useEffect } from 'react';import { useAuth } from '../lib/AuthContext';import { supabase } from '../lib/supabaseConfig';import { awardScore } from '../lib/supabaseApi';export function useUserPoints() {  const { user } = useAuth();  const [transactions, setTransactions] = useState([]);  const [totalPoints, setTotalPoints] = useState(0);  const [loading, setLoading] = useState(true);  const loadPointsData = async () => {    if (!user?.id) return;    try {      // 1. Puxa o histórico de transações direto do Supabase      const { data: txData } = await supabase        .from('transactions')        .select('*')        .eq('user_id', user.id)        .order('created_date', { ascending: false });      if (txData) setTransactions(txData);      // 2. Puxa o saldo atualizado da carteira      const { data: walletData } = await supabase        .from('wallets')        .select('balance')        .eq('user_id', user.id)        .single();      if (walletData) {        setTotalPoints(walletData.balance);      }    } catch (err) {      console.error("Erro ao carregar iTaCoins no Hook:", err);    } finally {      setLoading(false);    }  };  useEffect(() => {    loadPointsData();  }, [user]);  // Retorna uma função de reload para atualizar a tela quando necessário  return { transactions, totalPoints, loading, refetch: loadPointsData };}export function useAwardPoints() {  const { user } = useAuth();  const awardPoints = async (amount, description = 'Pontos recebidos') => {    if (!user?.id) return;    try {      // Usa a função RPC que criamos no seu banco de dados Supabase      await awardScore(user.id, amount);      return { success: true };    } catch (err) {      console.error("Erro ao premiar pontos:", err);      return { success: false, error: err };    }  };  return { awardPoints };}